# Copy outside Git as mode0600. Empty secrets are deliberately invalid.
PG_DATABASE_URL=
REDIS_URL=
APP_SECRET=
ENCRYPTION_KEY=
SERVER_URL=https://crm-recette.kovvalab.online
FRONTEND_URL=https://crm-recette.kovvalab.online
AUTH_COOKIE_ALLOWED_ORIGINS=https://crm-recette.kovvalab.online
AUTH_COOKIE_SAME_SITE=lax
# Set only the actual ingress proxy CIDR/IP; never blindly trust all proxies.
TRUST_PROXY=
DEFAULT_LOCALE=fr-FR
IS_MULTIWORKSPACE_ENABLED=false
IS_SAME_ORIGIN_MULTIWORKSPACE_ENABLED=true
HERMES_B2B_CAMPAIGNS_ENABLED=true
EMAIL_DRIVER=logger
EMAILING_DOMAIN_DRIVER=SMTP
EMAILING_SMTP_CONNECTIONS={}
OUTBOUND_HTTP_ALLOWED_INTERNAL_HOSTS=[]
TELEMETRY_ENABLED=false
IS_BILLING_ENABLED=false
IS_FDW_ENABLED=false
NODE_OPTIONS=--max-old-space-size=1536

REDIS_QUEUE_PREFIX=kovaalabcrm-staging
REDIS_CACHE_PREFIX=kovaalabcrm-staging
