{
  "name": "@lingui/core",
  "version": "6.10.1",
  "sideEffects": false,
  "description": "The Lingui i18n runtime: loads compiled message catalogs, tracks the active locale and formats ICU MessageFormat messages",
  "type": "module",
  "author": {
    "name": "Tomáš Ehrlich",
    "email": "tomas.ehrlich@gmail.com"
  },
  "license": "MIT",
  "keywords": [
    "lingui",
    "linguijs",
    "i18n",
    "icu",
    "messageformat",
    "catalog",
    "runtime",
    "localization",
    "translation",
    "pluralization"
  ],
  "scripts": {
    "build": "unbuild",
    "check-types": "tsc --noEmit"
  },
  "homepage": "https://lingui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lingui/js-lingui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/lingui/js-lingui/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./runtime-macro": "./dist/runtime-macro.mjs",
    "./macro": {
      "browser": "./macro/browser.mjs",
      "types": "./macro/index.d.mts",
      "default": "./macro/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/",
    "macro/browser.mjs",
    "macro/index.d.mts",
    "macro/index.mjs"
  ],
  "dependencies": {
    "@lingui/babel-plugin-lingui-macro": "6.10.1",
    "@lingui/message-utils": "6.10.1"
  },
  "devDependencies": {
    "@lingui/test-utils": "3.0.3",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "babel-plugin-macros": "2 || 3"
  },
  "peerDependenciesMeta": {
    "babel-plugin-macros": {
      "optional": true
    }
  },
  "unbuild": {
    "declaration": "node16"
  },
  "gitHead": "ce5aa25b536bbbf9cd4d1b02607631d6a296ebeb"
}
