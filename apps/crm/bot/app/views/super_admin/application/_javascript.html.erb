<%#
# Javascript Partial

This partial imports the necessary javascript on each page.
By default, it includes the application JS,
but each page can define additional JS sources
by providing a `content_for(:javascript)` block.
%>

<% Administrate::Engine.javascripts.each do |js_path| %>
  <%= javascript_include_tag js_path %>
<% end %>

<%= yield :javascript %>

<% if Rails.env.test? %>
  <%= javascript_tag do %>
    $.fx.off = true;
    $.ajaxSetup({ async: false });
  <% end %>
<% end %>

<% support_user = SuperAdmin.first %>
<script>
window.kovaa-labSettings = {
  hideMessageBubble: true,
};

(function(d,t) {
  var BASE_URL = '';
  var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
  g.src= BASE_URL + "/packs/js/sdk.js";
  g.async = true;
  s.parentNode.insertBefore(g,s);
  g.onload=function(){
    window.kovaa-labSDK.run({
      websiteToken: '<%= KovaaLab CharHub.support_config[:support_website_token] %>',
      baseUrl: '<%= KovaaLab CharHub.support_config[:support_script_url] %>'
    })
  }
})(document,"script");

window.addEventListener('kovaa-lab:ready', function() {
  window.$kovaa-lab.setUser('<%= KovaaLab CharHub.installation_identifier %>', {
    identifier_hash: '<%= KovaaLab CharHub.support_config[:support_identifier_hash] %>',
    email: '<%= support_user.email %>',
    name: '<%= support_user.name %>'
  });
})
</script>
