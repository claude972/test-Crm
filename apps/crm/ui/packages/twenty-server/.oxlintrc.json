{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  "jsPlugins": ["../kovaa-lab-oxlint-rules/dist/oxlint-plugin.mjs"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".local-storage",
    "src/engine/workspace-manager/dev-seeder/data/constants/**",
    "src/engine/workspace-manager/dev-seeder/data/seeds/**",
    "src/utils/email-providers.ts",
    "src/engine/core-modules/i18n/locales/generated/**",
    "src/engine/core-modules/logic-function/logic-function-resource/constants/seed-project/src/index.ts",
    "src/engine/metadata-modules/front-component/constants/seed-project/**",
    "src/engine/core-modules/upgrade/constants/kovaa-lab-current-version.constant.ts",
    "src/engine/core-modules/upgrade/constants/kovaa-lab-previous-versions.constant.ts",
    "src/engine/core-modules/upgrade/constants/kovaa-lab-next-versions.constant.ts"
  ],
  "rules": {
    "func-style": ["error", "declaration", { "allowArrowFunctions": true }],
    "no-console": [
      "warn",
      { "allow": ["group", "groupCollapsed", "groupEnd"] }
    ],
    "no-control-regex": "off",
    "no-debugger": "error",
    "no-duplicate-imports": "error",
    "no-undef": "off",
    "no-unused-vars": "off",
    "no-redeclare": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "kovaa-lab-shared/i18n",
            "importNames": ["generateMessageId"],
            "message": "Provider-owned metadata strings must resolve through resolveEffectiveEntityProperty, which owns the catalog lookup. Hashing message ids by hand is how the per-entity resolvers drifted apart."
          },
          {
            "name": "src/engine/core-modules/i18n/utils/translate-standard-label.util",
            "message": "Call resolveEffectiveEntityProperty instead: it arbitrates overrides and overrides.translations before delegating here."
          }
        ],
        "patterns": [
          {
            "group": ["**../"],
            "message": "Relative imports are not allowed."
          },
          {
            "group": ["lodash"],
            "message": "Please use the standalone lodash package (for instance: `import groupBy from 'lodash.groupby'` instead of `import { groupBy } from 'lodash'`)"
          }
        ]
      }
    ],

    "import/no-duplicates": "error",

    "typescript/no-redeclare": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/no-empty-object-type": [
      "error",
      {
        "allowInterfaces": "with-single-extends"
      }
    ],
    "typescript/no-empty-function": "off",
    "typescript/no-explicit-any": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "varsIgnorePattern": "^_",
        "args": "after-used",
        "argsIgnorePattern": "^_"
      }
    ],

    "kovaa-lab/inject-workspace-repository": "warn",
    "kovaa-lab/prefer-workspace-scoped-repository": "error",
    "kovaa-lab/rest-api-methods-should-be-guarded": "error",
    "kovaa-lab/graphql-resolvers-should-be-guarded": "error",
    "kovaa-lab/application-target-guards": "error",
    "kovaa-lab/upgrade-command-filename": "error",
    "kovaa-lab/no-runtime-import-from-upgrade-command": "error",
    "kovaa-lab/no-data-mutation-in-fast-instance-command": "error",
    "kovaa-lab/no-icu-escaping-apostrophe": "error",
    "kovaa-lab/no-miscased-acronym-in-identifier": "error",
    "kovaa-lab/no-miscased-acronym-in-message": "error",
    "kovaa-lab/types-folder-filename": [
      "error",
      { "convention": "kebab-case-type-suffix" }
    ],
    "kovaa-lab/enforce-module-boundaries": [
      "error",
      {
        "depConstraints": [
          {
            "sourceTag": "scope:backend",
            "onlyDependOnLibsWithTags": ["scope:shared", "scope:backend"]
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.spec.ts",
        "**/*.integration-spec.ts",
        "**/__tests__/**",
        "**/test/**"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["**/constants/*.ts", "**/*.constants.ts"],
      "rules": {
        "kovaa-lab/max-consts-per-file": "off"
      }
    },
    {
      "files": [
        "src/engine/core-modules/i18n/utils/translate-standard-label.util.ts",
        "src/engine/core-modules/tool-provider/**",
        "src/engine/metadata-modules/overrides/utils/resolve-effective-entity-property.util.ts",
        "src/engine/metadata-modules/overrides/utils/__tests__/**",
        "src/engine/core-modules/i18n/utils/__tests__/**",
        "src/engine/workspace-manager/kovaa-lab-standard-application/__tests__/**",
        "test/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**../"],
                "message": "Relative imports are not allowed."
              },
              {
                "group": ["lodash"],
                "message": "Please use the standalone lodash package (for instance: `import groupBy from 'lodash.groupby'` instead of `import { groupBy } from 'lodash'`)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/database/commands/upgrade-version-command/1-21/**",
        "src/database/commands/upgrade-version-command/2-8/**",
        "src/database/commands/upgrade-version-command/2-10/**",
        "src/database/commands/upgrade-version-command/2-19/**",
        "src/database/commands/upgrade-version-command/2-21/**",
        "src/database/commands/upgrade-version-command/2-23/**",
        "src/database/commands/upgrade-version-command/2-25/**",
        "src/database/commands/upgrade-version-command/2-33/**",
        "src/database/commands/upgrade-version-command/2-34/**",
        "src/database/commands/upgrade-version-command/2-39/**",
        "src/database/commands/upgrade-version-command/2-41/**"
      ],
      "rules": {
        "kovaa-lab/prefer-workspace-scoped-repository": "off"
      }
    }
  ]
}
